+
+  const audible = notes.filter((n) => !mute(n.track));
+  onProgress?.(`Scheduling ${audible.length} notes…`);
+  for (const n of audible) {
     const tr = tracks.find((t) => t.index === n.track);
     playNote(ctx, comp, n, tr, n.start, n.dur);
