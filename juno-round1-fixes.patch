-def patch(path, old, new, label):
-    p = pathlib.Path(path)
-    s = p.read_text(encoding="utf-8")
-    if new in s:
-        print(f"[skip] {label} (already applied)")
-        return
-    if s.count(old) != 1:
-        sys.exit(f"[FAIL] {label}: anchor not found exactly once in {path}")
-    p.write_text(s.replace(old, new), encoding="utf-8")
-    print(f"[ok]   {label}")
