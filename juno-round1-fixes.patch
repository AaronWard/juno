+/* ------------------------------------------------------------------ */
+/* Round-1 fixes: sidebar engine popover + collapsed sidebar geometry   */
+/* ------------------------------------------------------------------ */
+
+/* The Create panel used to render a second copy of the engine card. The
+   sidebar mini-widget is now the only one, and hovering expands it into the
+   full card (idle-unload time, VRAM, Load / Unload). */
+.engine-mini-wrap {
+  position: relative;
+}
+.engine-mini-pop {
+  position: absolute;
+  bottom: 0;
+  left: calc(100% + 10px);
+  width: 300px;
+  z-index: 60;
+  opacity: 0;
+  visibility: hidden;
+  transform: translateX(-6px);
+  transition: opacity 0.14s ease, transform 0.14s ease, visibility 0.14s;
+  pointer-events: none;
+}
+.engine-mini-pop .engine-card {
+  background: var(--color-bg-elevated, var(--color-bg-sidebar));
+  border: 1px solid var(--color-border);
+  border-radius: 12px;
+  padding: 12px;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
+}
+.engine-mini-wrap:hover .engine-mini-pop,
+.engine-mini-wrap:focus-within .engine-mini-pop {
+  opacity: 1;
+  visibility: visible;
+  transform: translateX(0);
+  pointer-events: auto;
+}
